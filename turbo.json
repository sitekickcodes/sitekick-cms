{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["AUTOSEND_API_KEY", "EMAIL_FROM", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "SITEKICK_AI_BUDGET_USD", "DATABASE_URL", "PAYLOAD_SECRET", "BLOB_READ_WRITE_TOKEN", "NEXT_PUBLIC_SERVER_URL", "VERCEL_URL"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "!.next/cache/**", "dist/**"] },
    "dev": { "cache": false, "persistent": true },
    "lint": {},
    "typecheck": { "dependsOn": ["^build"] },
    "test": {},
    "generate:types": { "cache": false },
    "generate:importmap": { "cache": false }
  }
}
